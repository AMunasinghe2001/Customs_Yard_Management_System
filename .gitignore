# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Local workspace metadata
.metadata

# Local helper or accidental files
$null
New Text Document.txt
refactor_theme.py
run_flutter.ps1
*.tmp
*.bak
*.orig

# Environment files — real credentials, never committed.
.env
.env.*
# …except the template, which carries no secrets and documents every key.
!.env.example

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Per-terminal build output from tool/run_instance.ps1 — see that script.
.flutter-instances/
