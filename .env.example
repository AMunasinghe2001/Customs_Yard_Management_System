# ============================================================================
#  SL Customs SR Management System — runtime configuration TEMPLATE
# ----------------------------------------------------------------------------
#  Copy this file to `.env`, fill in the real values, and restart the app:
#
#      copy .env.example .env
#
#  `.env` is gitignored; this template is not. Never put a real password here.
#
#  WHERE THE APP LOOKS, in order:
#    1. the folder holding cus_yard_management.exe   (an installed copy)
#    2. the project root                             (flutter run from source)
#
#  PRECEDENCE: a --dart-define given at build time beats this file, which
#  beats the compiled-in default. So an existing build that already passes
#  --dart-define keeps working exactly as before.
#
#  ⚠️ A .env on a DESKTOP app is not a secret store — it ships to the user's
#     machine, where it can be opened in Notepad. What it does buy is keeping
#     credentials out of the source tree and out of git. Anyone who can run
#     the app can read this file, so the database user it names should have
#     only the rights the app actually needs.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# The PC running PostgreSQL. `localhost` when the app and the database are on
# the same machine; otherwise the server's LAN address, e.g. 192.168.1.50 —
# or, for a branch office over the internet, the static public IP or domain
# the router forwards to, e.g. 203.0.113.10 or db.customs.gov.lk
#
# A scheme, a :port, a /database or a user:pass@ prefix is trimmed off, and a
# bare IPv6 literal is bracketed, so pasting a connection string here works.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=Customs_SR_DB
# Never connect a deployed desktop app as postgres: superusers bypass the RLS
# policies that separate GL1, GL2 and the other yards. Provision this role with
# postgres/66_yard_app_role.sql, then use its unique password here.
PG_USER=yard_app
PG_PASSWORD=change-me

# TLS. Leave both false on a LAN with no certificate.
#   PG_SSL=true         encrypt the connection
#   PG_SSL_VERIFY=true  ALSO verify the server's certificate
#
# ⚠️ PG_SSL alone accepts ANY certificate, so it stops eavesdropping but not a
#    man-in-the-middle. Over anything but a trusted LAN — a cloud database, a
#    link between offices — set BOTH.
PG_SSL=false
PG_SSL_VERIFY=false

# The server's CA certificate, for verified TLS against a SELF-SIGNED
# certificate — the normal case for an office server behind a static IP,
# because nobody issues a public certificate for a bare address.
#
# Without it PG_SSL_VERIFY=true checks the chain against Windows' trust store,
# which has never heard of your certificate, so every connection fails — and
# the usual "fix" is to turn verification back off, which re-opens the
# man-in-the-middle hole the whole setting exists to close.
#
# Copy ca.crt beside the .exe and name it here. A relative path is resolved
# from the executable's own folder. Leave EMPTY when the certificate comes
# from a real CA (Let's Encrypt on a domain) — the OS store is then correct.
PG_SSL_ROOT_CERT=

# Refuse to start rather than connect insecurely. Set this on every machine
# outside the office LAN: it turns a mistyped PG_SSL into a startup failure
# instead of a silent downgrade to plaintext over the public internet.
PG_REQUIRE_TLS=false

# Seconds. 10s suits a LAN; raise it for a remote/cloud database — a branch
# office on ADSL or mobile data is several hundred ms away, not one hop.
PG_CONNECT_TIMEOUT=10
PG_QUERY_TIMEOUT=60

# ── Internet deployment (static IP + port forwarding) ───────────────────────
# A branch office connecting over the public internet should set:
#
#   PG_HOST=203.0.113.10        the static public IP, or the domain
#   PG_SSL=true                 encrypt
#   PG_SSL_VERIFY=true          AND verify — without this, encryption alone
#                               stops eavesdropping but not interception
#   PG_SSL_ROOT_CERT=ca.crt     the office CA, copied beside the .exe
#   PG_REQUIRE_TLS=true         fail loudly rather than connect in clear
#   PG_CONNECT_TIMEOUT=20       the internet is slower than a LAN
#
# ⚠️ Port-forwarding 5432 puts PostgreSQL on the open internet, where it is
#    scanned continuously. TLS protects the traffic; it does not protect the
#    port. Restrict the forwarding rule to the branch offices' own addresses
#    where the ISP allows a static one, and keep pg_hba.conf to `hostssl` with
#    scram-sha-256 so a plaintext or trust-auth attempt is refused server-side
#    as well as client-side.

# ── OTP e-mail (Gmail SMTP) ─────────────────────────────────────────────────
# The account that sends login / sign-up verification codes. Needs 2-Step
# Verification ON and a 16-character App Password (NOT the normal password):
# Google Account → Security → App passwords.
#
# Use a dedicated account, never a personal one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=SL Customs
