# ============================================================================
#  SL Customs SR Management System — runtime configuration TEMPLATE
# ----------------------------------------------------------------------------
#  Copy this file to `.env`, fill in the real values, and restart the app:
#
#      copy .env.example .env
#
#  `.env` is gitignored; this template is not. Never put a real password here.
#
#  WHERE THE APP LOOKS, in order:
#    1. the folder holding cus_yard_management.exe   (an installed copy)
#    2. the project root                             (flutter run from source)
#
#  PRECEDENCE: a --dart-define given at build time beats this file, which
#  beats the compiled-in default. So an existing build that already passes
#  --dart-define keeps working exactly as before.
#
#  ⚠️ A .env on a DESKTOP app is not a secret store — it ships to the user's
#     machine, where it can be opened in Notepad. What it does buy is keeping
#     credentials out of the source tree and out of git. Anyone who can run
#     the app can read this file, so the database user it names should have
#     only the rights the app actually needs.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# The PC running PostgreSQL. `localhost` when the app and the database are on
# the same machine; otherwise the server's LAN address, e.g. 192.168.1.50
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=Customs_SR_DB
PG_USER=postgres
PG_PASSWORD=change-me

# TLS. Leave both false on a LAN with no certificate.
#   PG_SSL=true         encrypt the connection
#   PG_SSL_VERIFY=true  ALSO verify the server's certificate
#
# ⚠️ PG_SSL alone accepts ANY certificate, so it stops eavesdropping but not a
#    man-in-the-middle. Over anything but a trusted LAN — a cloud database, a
#    link between offices — set BOTH.
PG_SSL=false
PG_SSL_VERIFY=false

# Seconds. 10s suits a LAN; raise it for a remote/cloud database.
PG_CONNECT_TIMEOUT=10
PG_QUERY_TIMEOUT=60

# ── OTP e-mail (Gmail SMTP) ─────────────────────────────────────────────────
# The account that sends login / sign-up verification codes. Needs 2-Step
# Verification ON and a 16-character App Password (NOT the normal password):
# Google Account → Security → App passwords.
#
# Use a dedicated account, never a personal one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=SL Customs
